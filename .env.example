# DOE Framework - Environment Variables
# Copie este arquivo para .env e preencha com seus valores reais

# =====================================
# JIRA CONFIGURATION
# =====================================
JIRA_URL=https://your-company.atlassian.net
JIRA_EMAIL=your.email@company.com
JIRA_API_TOKEN=your_jira_api_token_here

# Obter token: Jira → Profile → Security → API Tokens
# Permissões necessárias: Browse Projects, View Issues

# =====================================
# GITHUB CONFIGURATION
# =====================================
GITHUB_TOKEN=ghp_your_github_personal_access_token
GITHUB_ORG=your-organization

# Obter token: GitHub → Settings → Developer Settings → Personal Access Tokens
# Scopes necessários: repo, read:org, read:user

# =====================================
# GOOGLE WORKSPACE (Docs, Sheets, Drive)
# =====================================
GOOGLE_CREDENTIALS_PATH=credentials.json

# Setup OAuth:
# 1. Console Google Cloud → Enable APIs (Docs, Sheets, Drive)
# 2. Create OAuth 2.0 Client ID
# 3. Download JSON → salvar como credentials.json
# token.json será gerado automaticamente no primeiro uso

# =====================================
# ANTHROPIC CLAUDE API
# =====================================
ANTHROPIC_API_KEY=sk-ant-your_claude_api_key_here

# Obter key: https://console.anthropic.com/account/keys
# Usado para: geração de insights, sumarização, análise de texto

# =====================================
# SLACK NOTIFICATIONS
# =====================================
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_DEFAULT_CHANNEL=#engineering-metrics

# Setup Webhook:
# 1. Slack → Apps → Incoming Webhooks
# 2. Add to Workspace
# 3. Copy Webhook URL

# =====================================
# CI/CD INTEGRATIONS (Opcional)
# =====================================

# Jenkins
JENKINS_URL=https://jenkins.company.com
JENKINS_USER=your_username
JENKINS_TOKEN=your_jenkins_token

# CircleCI
CIRCLECI_TOKEN=your_circleci_token
CIRCLECI_ORG=your-org

# GitLab CI
GITLAB_URL=https://gitlab.company.com
GITLAB_TOKEN=your_gitlab_token
GITLAB_PROJECT_ID=12345

# =====================================
# OUTROS SERVIÇOS (Opcional)
# =====================================

# Apify (para web scraping)
APIFY_API_TOKEN=apify_api_your_token

# SendGrid (para emails)
SENDGRID_API_KEY=SG.your_sendgrid_key

# Firebase (se usar para SaaS projects)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CREDENTIALS_PATH=firebase-credentials.json

# =====================================
# CONFIGURAÇÕES GERAIS
# =====================================

# Diretório temporário (default: .tmp)
TMP_DIR=.tmp

# Nível de log (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Timeout para requests HTTP (segundos)
HTTP_TIMEOUT=30

# Retry attempts para APIs
MAX_RETRIES=3

# =====================================
# DESENVOLVIMENTO/PRODUÇÃO
# =====================================

# Environment (development, staging, production)
ENV=development

# Debug mode (true/false)
DEBUG=true

# =====================================
# NOTAS DE SEGURANÇA
# =====================================
# - NUNCA commitar .env no Git
# - Adicionar .env ao .gitignore
# - Rotacionar tokens regularmente
# - Usar variáveis de ambiente em CI/CD
# - Para produção, usar secrets management (AWS Secrets Manager, etc.)
